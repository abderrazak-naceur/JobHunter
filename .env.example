# Local environment examples (set these in your shell; .NET and Vite do not load this root file automatically).
# For local development prefer ./scripts/setup-dev-secrets.ps1, which stores them in .NET user-secrets.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=jobhunter;Username=jobhunter_app;Password=CHANGE_ME
# Admin login: create the hash with `dotnet run --project src/backend/JobHunter.Api -- hash-password`
Admin__Username=admin
Admin__PasswordHash=CHANGE_ME_PBKDF2_HASH
# Random secret, at least 32 characters
Jwt__SigningKey=CHANGE_ME_RANDOM_32+_CHARACTERS
# Browser origin(s) allowed to call the API (required outside Development)
Cors__AllowedOrigins__0=http://localhost:5173
# Put VITE_API_BASE_URL in src/frontend/.env.local
VITE_API_BASE_URL=http://localhost:5000
